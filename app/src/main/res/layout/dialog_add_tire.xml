<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lastik Değişimi Kaydet"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:textColor="#333"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Takılan Lastik Türü:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgTireType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbSummer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yazlık"
            android:layout_weight="1"/>

        <RadioButton
            android:id="@+id/rbWinter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kışlık"
            android:checked="true"
            android:layout_weight="1"/>
    </RadioGroup>

    <EditText
        android:id="@+id/etTireDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Değişim Tarihi"
        android:focusable="false"
        android:inputType="date"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etTireNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Notlar (Örn: Michelin takıldı)"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etTireCost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Maliyet (TL)"
        android:inputType="number"/>

</LinearLayout>