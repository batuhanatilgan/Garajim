<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgTireIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_snow"
            app:tint="#2196F3"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#E3F2FD"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/txtTireType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kış Lastiği Takıldı"
                android:textStyle="bold"
                android:textColor="#333"/>

            <TextView
                android:id="@+id/txtTireDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17.12.2025"
                android:textSize="12sp"
                android:textColor="#666"/>

            <TextView
                android:id="@+id/txtTireNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notlar buraya..."
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:textColor="#555"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>