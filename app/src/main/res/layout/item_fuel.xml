<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/stat_sys_warning"
            app:tint="#E91E63"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#FCE4EC"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/txtFuelDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17.12.2025"
                android:textStyle="bold"
                android:textColor="#333"/>

            <TextView
                android:id="@+id/txtFuelInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42.5 Lt x 40.50 TL"
                android:textSize="12sp"
                android:textColor="#666"/>

            <TextView
                android:id="@+id/txtFuelKm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="125.600 KM"
                android:textSize="12sp"
                android:textColor="#FF5722"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtFuelCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.720 TL"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#4CAF50"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>