<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FCE4EC">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@android:drawable/stat_sys_warning"
                app:tint="#E91E63"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/txtFuelDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17.12.2025"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/txtFuelInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42.5 Lt x 40.50 TL"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/txtFuelKm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="125.600 KM"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#E91E63"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtFuelCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.720 TL"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/success_green"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>